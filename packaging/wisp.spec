# PyInstaller spec for Wisp: a windowed "onedir" build in dist\Wisp (DECISIONS.md D-037).
# Build with:  .venv\Scripts\python packaging\build.py   (runs this spec and the self-check)
# Sources: pyinstaller.org/en/stable/spec-files.html, .../hooks.html (collect_submodules,
# copy_metadata), .../usage.html#windows-specific-options (version resource, icon).

import sys
from pathlib import Path

from PyInstaller.utils.hooks import collect_submodules, copy_metadata
from PyInstaller.utils.win32.versioninfo import (
    FixedFileInfo,
    StringFileInfo,
    StringStruct,
    StringTable,
    VarFileInfo,
    VarStruct,
    VSVersionInfo,
)

ROOT = Path(SPECPATH).parent  # noqa: F821  (SPECPATH is provided by PyInstaller)
sys.path.insert(0, str(ROOT / "src"))
from wisp import __version__  # noqa: E402

numbers = tuple(int(part) for part in __version__.split(".")) + (0,)
version_info = VSVersionInfo(
    ffi=FixedFileInfo(filevers=numbers, prodvers=numbers),
    kids=[
        StringFileInfo([StringTable("040904B0", [
            StringStruct("CompanyName", "Wisp"),
            StringStruct("FileDescription", "Wisp voice assistant"),
            StringStruct("FileVersion", __version__),
            StringStruct("InternalName", "Wisp"),
            StringStruct("OriginalFilename", "Wisp.exe"),
            StringStruct("ProductName", "Wisp"),
            StringStruct("ProductVersion", __version__),
        ])]),
        VarFileInfo([VarStruct("Translation", [1033, 1200])]),
    ],
)

hiddenimports = (
    collect_submodules("wisp")  # some modules are only reached by name (APScheduler job refs)
    + collect_submodules("winrt")  # pywinrt projections import their native parts lazily
    # UI Automation wrapper generated by build.py, so the app never writes generated code.
    + collect_submodules("comtypes.gen")
    + ["sqlalchemy.dialects.sqlite"]
)
for wrapper in ("comtypes.gen.UIAutomationClient", "comtypes.gen.NETWORKLIST"):
    if wrapper not in hiddenimports:
        raise SystemExit(f"{wrapper} missing: run packaging/build.py")
datas = (
    copy_metadata("APScheduler")  # trigger/executor aliases are entry points
    + copy_metadata("google-genai")
    + [(str(ROOT / "build" / "THIRD_PARTY_NOTICES.txt"), ".")]
    + [(str(ROOT / "LICENSE"), ".")]  # Wisp's MIT licence, next to the notices
    + [(str(ROOT / "src" / "wisp" / "assets" / "icons"), "wisp/assets/icons")]  # Lucide (ISC)
)

a = Analysis(  # noqa: F821
    [str(ROOT / "packaging" / "launcher.py")],
    pathex=[str(ROOT / "src")],
    hiddenimports=hiddenimports,
    datas=datas,
    excludes=["tkinter", "pytest", "_pytest", "pytestqt", "IPython", "matplotlib"],
    noarchive=False,
)
# Not needed (D-037): Qt's software OpenGL fallback and translations (a Qt Widgets app with an
# English UI that never installs a QTranslator), and PortAudio builds for other platforms (this
# is an x64 build; sounddevice loads libportaudio64bit.dll).
UNUSED = ("opengl32sw.dll", "PySide6/translations/", "portaudio-binaries/libportaudio.dylib",
          "portaudio-binaries/libportaudio32bit", "portaudio-binaries/libportaudioarm64")
# The googleapiclient hook bundles all ~600 discovery documents (112 MB); Wisp builds only the
# Calendar v3 client with static_discovery=True, which reads just this one file (D-050).
DISCOVERY = "googleapiclient/discovery_cache/documents/"
KEEP_DISCOVERY = DISCOVERY + "calendar.v3.json"


def wanted(entry) -> bool:
    name = entry[0].replace(chr(92), "/")  # chr(92) is a backslash
    if DISCOVERY in name:
        return name.endswith(KEEP_DISCOVERY)
    return not any(part in name for part in UNUSED)


a.binaries = [b for b in a.binaries if wanted(b)]
a.datas = [d for d in a.datas if wanted(d)]

pyz = PYZ(a.pure)  # noqa: F821
exe = EXE(  # noqa: F821
    pyz,
    a.scripts,
    [],
    exclude_binaries=True,
    name="Wisp",
    icon=str(ROOT / "packaging" / "wisp.ico"),
    version=version_info,
    console=False,
    upx=False,
)
coll = COLLECT(  # noqa: F821
    exe,
    a.binaries,
    a.datas,
    name="Wisp",
    upx=False,
)
